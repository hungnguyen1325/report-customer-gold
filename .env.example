# ==============================================================================
# HỆ THỐNG QUẢN TRỊ & BÁO CÁO GIAO DỊCH VÀNG
# File mẫu cấu hình biến môi trường (Environment Configuration Template)
# 
# HƯỚNG DẪN:
# 1. Sao chép file này thành .env:
#    cp .env.example .env
# 2. Điền thông tin kết nối SQL Server và khóa bảo mật thực tế vào file .env
# ==============================================================================

# Cấu hình kết nối Microsoft SQL Server
DATABASE_HOST=your_server_ip_or_localhost
DATABASE_PORT=1433
DATABASE_USER=your_db_username
DATABASE_PASS=your_db_password
DATABASE_NAME=your_database_name
DATABASE_ENCRYPT=false

# Khóa bí mật ký mã JSON Web Token (JWT) cho phiên đăng nhập
# Bạn có thể tạo khóa ngẫu nhiên bằng lệnh: openssl rand -hex 32
JWT_SECRET=your_secret_key_minimum_32_characters_long_here
